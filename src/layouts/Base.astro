---
import '../styles/global.css';import {checkApprovals} from '../lib/approvals';checkApprovals();import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import StaticPreviewBanner from '../components/StaticPreviewBanner.astro';import MobileActionBar from '../components/MobileActionBar.astro';import {business as b} from '@content/business';
interface Props{title:string;description:string;hasForm?:boolean;schema?:Record<string,unknown>[];breadcrumbs?:{name:string;href:string}[];noindex?:boolean;hero?:boolean}
const {title,description,hasForm=false,schema=[],breadcrumbs=[],noindex=false,hero=false}=Astro.props;const canonical=new URL(Astro.url.pathname,b.url).href;
const local={ '@type':'Plumber','@id':b.url+'/#business',name:b.name,url:b.url,telephone:b.tel,email:b.email,...(b.showAddress?{address:{'@type':'PostalAddress',streetAddress:b.address.street,addressLocality:b.address.city,addressRegion:b.address.region,postalCode:b.address.zip,addressCountry:'US'}}:{}),openingHours:'Mo-Su 00:00-23:59',areaServed:b.areas.map(name=>({'@type':'Place',name})),sameAs:Object.values(b.profiles),logo:b.url+'/images/brand-logo.png'};
const crumbs=breadcrumbs.length?{'@type':'BreadcrumbList',itemListElement:[{name:'Home',href:'/'},...breadcrumbs].map((it,i)=>({'@type':'ListItem',position:i+1,name:it.name,item:new URL(it.href,b.url).href}))}:null;
const graph={'@context':'https://schema.org','@graph':[local,...schema,...(crumbs?[crumbs]:[])]};
---
<!doctype html><html lang="en-US"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>{hero&&<><link rel="preload" as="image" href="/images/sf-blueprint.webp" media="(min-width:601px)"/><link rel="preload" as="image" href="/images/sf-blueprint-small.webp" media="(max-width:600px)"/></>}<meta name="theme-color" content="#0b3c48"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<link rel="icon" href="/images/brand-icon.png" type="image/png"/><link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><meta property="og:type" content="website"/><meta property="og:site_name" content={b.shortName}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={b.url+'/images/social-cover.jpg'}/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\\u003c')}/></head><body><Header hasForm={hasForm}/><main id="main-content" tabindex="-1"><slot/></main><Footer/><MobileActionBar hasForm={hasForm}/><div id="analytics-config" data-gtm={b.analytics.gtmId} data-ga={b.analytics.ga4Id} hidden></div><StaticPreviewBanner/><script src="../scripts/navigation.ts"></script></body></html>

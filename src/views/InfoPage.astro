---
import {getCollection} from 'astro:content';import Base from '../layouts/Base.astro';import PageHero from '../components/PageHero.astro';import SmallCTA from '../components/SmallCTA.astro';import Icon from '../components/Icon.astro';import SectionLabel from '../components/SectionLabel.astro';import RequestForm from '../components/RequestForm.astro';import ContactBlock from '../components/ContactBlock.astro';import TrustBar from '../components/TrustBar.astro';import ReviewList from '../components/ReviewList.astro';import VideoFacade from '../components/VideoFacade.astro';import ArticleLibrary from '../components/ArticleLibrary.astro';import FAQ from '../components/FAQAccordion.astro';import ServiceCard from '../components/ServiceCard.astro';import PolicyText from '../components/PolicyText.astro';import privacyText from '../../content/legal/privacy-policy.md?raw';import termsText from '../../content/legal/terms-of-service.md?raw';import {pages} from '@content/pages';import {requestFAQs as faqs} from '@content/faqs';import {business,phoneLink,address} from '@content/business';import {categories,urls} from '@content/navigation';
const {id}=Astro.props;const p=pages[id];const current='/'+id+'/';const label=p.label.split(' / ').pop()!;const crumbs=[{name:id==='blog'?'Plumbing journal':id==='service-areas'?'Service areas':id==='about-us'?'About us':label.charAt(0)+label.slice(1).toLowerCase(),href:current}];const title=id==='contact-us'?'Contact & request service':id==='blog'?'Plumbing journal':id==='service-areas'?'Plumbing service areas':id==='reviews'?'Customer reviews & credentials':id==='resources'?'Plumbing resources':id==='about-us'?'About our plumbing company':p.title.replace(/\.$/,'');const allPosts=(await getCollection('blog')).sort((a,b)=>a.data.title.localeCompare(b.data.title));const services=await getCollection('services');const hasForm=id==='contact-us'||id==='recent-projects';
const schema=id==='resources'?[{'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}]:[];
---
<Base title={title+' | '+business.shortName} description={p.description} breadcrumbs={crumbs} hasForm={hasForm} schema={schema}>
 <PageHero title={p.title} label={p.label} intro={p.intro} crumbs={crumbs} actions={id==='about-us'||id==='service-areas'||id==='contact-us'} hasForm={hasForm}/>
 {id==='contact-us'&&<><RequestForm/><ContactBlock full/></>}
 {id==='about-us'&&<><div class="page-content"><div class="container"><div class="two-column"><div class="prose"><SectionLabel text="OUR COMPANY"/><h2>Plumbing for homes and businesses.</h2><p>From a leaking fixture to a shared sewer line, the first step is understanding the problem. Our work covers general plumbing, sewer and drain systems, water heaters, and commercial properties.</p><p>Call the office any time, or use our service request form to tell us what needs attention.</p><a class="text-link" href={urls.plumbing}>Explore our services <Icon name="arrow" size={16}/></a></div><aside class="side-panel"><h3>Company details</h3><p class="text-sm">{business.name}<br/>CA License #{business.license}<br/>{business.hours}</p><a href={urls.areas}>Our service areas <Icon name="arrow" size={14}/></a><a href={urls.reviews}>Reviews & credentials <Icon name="arrow" size={14}/></a></aside></div><div class="about-photo"><VideoFacade/></div></div></div><TrustBar/><SmallCTA/></>}
 {id==='service-areas'&&<><section class="page-content"><div class="container city-grid">{[{name:'San Francisco',key:'san-francisco',text:'Residential and commercial plumbing across San Francisco. Explore services for leaking pipes, blocked drains, and hot-water issues.',link:urls.plumbing,cta:'Explore San Francisco services'},{name:'Daly City',key:'daly-city',text:'Find local plumbing, fixture repair, hydro-jetting, drain cleaning, and water heater services for your Daly City property.',link:urls.daly,cta:'Daly City plumbing'},{name:'South San Francisco',key:'south-san-francisco',text:'Request help for a home, business, or multi-unit building in South San Francisco.',link:urls.south,cta:'South San Francisco plumbing'},{name:'San Mateo County',key:'san-mateo-county',text:'Not sure whether your address is covered? Share your town and ZIP code with the office to confirm service availability.',link:urls.contact,cta:'Confirm your service area'}].map(c=><article id={c.key} class="city-card"><Icon name="pin" size={25}/><h2>{c.name}</h2><p>{c.text}</p><a class="text-link" href={c.link}>{c.cta}<Icon name="arrow" size={15}/></a></article>)}</div></section><SmallCTA/></>}
 {id==='reviews'&&<><ReviewList full/><TrustBar/><SmallCTA/></>}
 {id==='blog'&&<><section class="page-content"><ArticleLibrary/></section><SmallCTA/></>}
 {id==='resources'&&<><section class="page-content"><div class="container"><div class="resource-grid">{[{name:'Plumbing journal',icon:'file',intro:'Browse articles about drainage, hot water, leaks, and everyday plumbing questions.',link:urls.blog,cta:'Read the journal'},{name:'Media room',icon:'briefcase',intro:'Find company facts and the right contact for a business or media inquiry.',link:urls.media,cta:'Visit the media room'},{name:'Service directory',icon:'tools',intro:'Learn what each service covers, what signs to look for, and what affects cost.',link:urls.plumbing+'#services-directory',cta:'Explore our services'},{name:'Service coverage',icon:'map',intro:'Check local information for San Francisco, Daly City, and South San Francisco.',link:urls.areas,cta:'View service areas'}].map(c=><article class="info-card"><Icon name={c.icon} size={26}/><h2>{c.name}</h2><p>{c.intro}</p><a class="text-link" href={c.link}>{c.cta}<Icon name="arrow" size={15}/></a></article>)}</div><div class="prose mt-10"><h2>Requesting service</h2><FAQ items={faqs}/></div></div></section><SmallCTA/></>}
 {id==='media-room'&&<><section class="page-content"><div class="container two-column"><div class="prose"><SectionLabel text="COMPANY FACT SHEET"/><h2>{business.name}</h2><p>Residential and commercial plumbing in San Francisco and San Mateo County, including Daly City and South San Francisco.</p><ul><li>Services: general plumbing, sewer and drain work, water heaters, and commercial plumbing.</li><li>California contractor license: {business.license}.</li><li>Hours: {business.hours.toLowerCase()}.</li>{business.showAddress&&<li>Office address: {address}.</li>}</ul><a class="text-link" href="/downloads/company-facts.txt" download>Download company facts <Icon name="file" size={15}/></a></div><aside class="side-panel"><h3>Media & business inquiries</h3><p class="text-sm">For information, images, or permission to use company materials, contact the office.</p><a href={'mailto:'+business.email}>{business.email}<Icon name="mail" size={14}/></a><a href={phoneLink}>{business.phone}<Icon name="phone" size={14}/></a></aside></div></section><SmallCTA/></>}
 {id==='accessibility'&&<section class="page-content"><article class="container article-reading prose"><h2>Using this website</h2><p>The site uses keyboard-operable navigation, visible focus indicators, labelled form fields, and text descriptions for informative images. Maps load only when requested, and the site respects reduced-motion preferences.</p><p>Use the “Skip to content” link at the beginning of each page to bypass navigation. On the request form, errors are shown beside the field that needs attention.</p><h2>Report a barrier</h2><p>If a page or form is difficult to use, email <a href={'mailto:'+business.email}>{business.email}</a> or call <a href={phoneLink}>{business.phone}</a>. Include the page address and describe the problem. Please do not include sensitive information.</p><h2>Other ways to request service</h2><p>You do not need to use the online form. Call the office at any time to discuss a plumbing issue or request service.</p></article></section>}
 {(id==='privacy-policy'||id==='terms-of-service')&&<div class="page-content"><article class="container article-reading prose legal-content">{id==='privacy-policy'?<><button type="button" class="privacy-open button button-outline mb-6">Manage privacy choices</button><PolicyText text={privacyText}/></>:<PolicyText text={termsText}/>}</article></div>}
 {id==='sitemap'&&<section class="page-content"><div class="container"><div class="sitemap-groups"><div class="sitemap-group"><h2>Company & resources</h2><a href="/">Homepage</a>{Object.entries(pages).filter(([k])=>k!=='sitemap').map(([k,v])=><a href={'/'+k+'/'}>{k==='about-us'?'About us':k==='contact-us'?'Contact us':k==='blog'?'Plumbing journal':v.title.replace(/\.$/,'')}</a>)}</div><div class="sitemap-group"><h2>Plumbing services</h2>{services.filter(s=>s.data.city==='San Francisco').map(s=><a href={s.data.path}>{s.data.title}</a>)}</div><div class="sitemap-group"><h2>Local service</h2><a href={urls.daly}>Daly City plumbing</a><a href={urls.south}>South San Francisco plumbing</a>{services.filter(s=>s.data.city==='Daly City').map(s=><a href={s.data.path}>{s.data.title} in Daly City</a>)}</div></div><h2 class="text-2xl mb-4">Article archive</h2><div class="sitemap-articles">{allPosts.map(p=><a href={p.data.path}>{p.data.title}</a>)}</div></div></section>}
 {id==='recent-projects'&&<><section class="services-section section-space"><div class="container"><div class="section-heading"><h2>Explore project services.</h2></div><div class="services-grid">{categories.map(item=><ServiceCard item={item}/>)}</div></div></section><RequestForm/></>}
</Base>

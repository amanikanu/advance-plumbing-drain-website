---
import {render,type CollectionEntry} from 'astro:content';import Base from '../layouts/Base.astro';import PageHero from '../components/PageHero.astro';import SmallCTA from '../components/SmallCTA.astro';import Icon from '../components/Icon.astro';import {business} from '@content/business';
interface Props{entry:CollectionEntry<'blog'>};const {entry}=Astro.props;const p=entry.data;const {Content}=await render(entry);const crumbs=[{name:'Plumbing journal',href:'/blog/'},{name:p.category,href:p.path}];
---
<Base title={p.title+' | '+business.shortName} description={p.description} breadcrumbs={crumbs} schema={[{'@type':'BlogPosting',headline:p.title,datePublished:p.date,author:{'@id':business.url+'/#business'},mainEntityOfPage:business.url+p.path}]}><PageHero title={p.title} label={'FIELD NOTES / '+p.category.toUpperCase()} crumbs={crumbs}><div class="article-byline"><time datetime={p.date}>{new Date(p.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</time><span>/</span>{business.shortName}</div></PageHero><div class="page-content"><article class="container article-reading prose"><Content/><div class="article-reader-footer"><a class="text-link" href="/blog/"><Icon name="back" size={15}/>Back to the journal</a><a class="text-link" href="/plumbing-services-sf/">Explore plumbing services <Icon name="arrow" size={15}/></a></div></article></div><SmallCTA/></Base>

---
import {getCollection,type CollectionEntry} from 'astro:content';import Base from '../layouts/Base.astro';import PageHero from '../components/PageHero.astro';import RequestForm from '../components/RequestForm.astro';import ServiceCard from '../components/ServiceCard.astro';import SectionLabel from '../components/SectionLabel.astro';import Icon from '../components/Icon.astro';import FAQ from '../components/FAQAccordion.astro';import {business} from '@content/business';import {categories} from '@content/navigation';
interface Props{entry:CollectionEntry<'locations'>};const {entry}=Astro.props;const l=entry.data;const crumbs=[{name:'Service areas',href:'/service-areas/'},{name:l.title,href:l.path}];const local=(await getCollection('services')).filter(s=>s.data.city===l.title);const schema=[{'@type':'FAQPage',mainEntity:l.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<Base title={'Plumber in '+l.title+' | '+business.shortName} description={l.description} hasForm breadcrumbs={crumbs} schema={schema}><PageHero title={'Plumbing in '+l.title+'.'} label="LOCAL SERVICE AREA" intro={l.intro} crumbs={crumbs} actions hasForm/><section class="section-space services-section"><div class="container"><div class="section-heading"><div><SectionLabel text="LOCAL PLUMBING SERVICES"/><h2>How can we help?</h2></div></div><div class="services-grid">{categories.map(item=><ServiceCard item={item}/>)}</div></div></section><section class="page-content"><div class="container two-column"><div><SectionLabel text="LOCAL SERVICE QUESTIONS"/><h2 class="mb-6">Good to know.</h2><FAQ items={l.faq}/></div><aside class="side-panel"><h3>{local.length?'Services in '+l.title:'Nearby service areas'}</h3>{(local.length?local.map(s=>({name:s.data.title,href:s.data.path})):[{name:'San Francisco',href:'/service-areas/#san-francisco'},{name:'Daly City',href:'/plumbers-in-daly-city-ca/'}]).map(x=><a href={x.href}>{x.name}<Icon name="arrow" size={14}/></a>)}</aside></div></section><RequestForm/></Base>

---
import {getCollection,type CollectionEntry} from 'astro:content';import Base from '../layouts/Base.astro';import PageHero from '../components/PageHero.astro';import FAQ from '../components/FAQAccordion.astro';import RequestForm from '../components/RequestForm.astro';import Icon from '../components/Icon.astro';import SectionLabel from '../components/SectionLabel.astro';import {business as b} from '@content/business';import {urls,categories} from '@content/navigation';
interface Props{entry:CollectionEntry<'services'>};const {entry}=Astro.props;const s=entry.data,isHub=s.path===urls.plumbing;const all=(await getCollection('services')).filter(e=>e.data.city==='San Francisco');const group={plumbing:categories[0],sewer:categories[1],heater:categories[2],commercial:categories[3]}[s.group];
const crumbs=[...(!isHub?[{name:'Services',href:urls.plumbing}]:[]),{name:s.title,href:s.path}];const title=s.title+' in '+s.city;const related=all.filter(e=>e.id!==entry.id&&e.data.group===s.group).slice(0,5);const schema=[{'@type':'Service',name:title,serviceType:s.title,description:s.intro,provider:{'@id':b.url+'/#business'},areaServed:{'@type':'Place',name:s.city}},{'@type':'FAQPage',mainEntity:s.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<Base title={title+' | '+b.shortName} description={s.description} hasForm breadcrumbs={crumbs} schema={schema}><PageHero title={title} label="PLUMBING SERVICES" intro={s.intro} crumbs={crumbs} art={group.icon} actions hasForm/>
{isHub&&<section class="directory" id="services-directory"><div class="container"><SectionLabel text="SERVICE DIRECTORY"/><h2>Find the right service.</h2><div class="directory-grid">{(['plumbing','sewer','heater','commercial'] as const).map((g,i)=><div class="directory-group"><h3>{categories[i].name}</h3><div class="directory-links">{all.filter(e=>e.data.group===g&&!e.data.path.endsWith('/plumbing-services-sf/')).map(e=><a href={e.data.path}>{e.data.title}<Icon name="arrow" size={14}/></a>)}</div></div>)}</div></div></section>}
<section class="page-content"><div class="container service-layout"><div><SectionLabel text="WHAT TO LOOK FOR"/><h2>Signs you may need help</h2><ul class="check-list">{s.symptoms.map(x=><li><Icon name="checkCircle" size={17}/>{x}</li>)}</ul><h2>How we approach the repair</h2><p>{s.process}</p><h2>What affects the cost?</h2><p>{s.cost} We discuss the scope and estimate before carrying out the agreed work.</p><h2>Common questions</h2><FAQ items={s.faq}/></div><aside class="side-panel"><div class="section-label">EXPLORE SERVICES</div><h2>Related services</h2>{(related.length?related.map(e=>({name:e.data.title,href:e.data.path})):categories.filter(c=>c.href!==s.path)).map(c=><a href={c.href}>{c.name}<Icon name="arrow" size={14}/></a>)}<a href={urls.plumbing+'#services-directory'}>All plumbing services <Icon name="list" size={15}/></a></aside></div></section>
<RequestForm service={s.serviceType==='Other'?'':s.serviceType} emergency={s.path===urls.emergency}/></Base>

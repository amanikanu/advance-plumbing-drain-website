---
import {businessText} from '../lib/business-text';const {text}=Astro.props as {text:string};const parts=businessText(text).trim().split(/\n\s*\n/);const blocks:{kind:'p'|'h2'|'ul';text:string;items?:string[]}[]=[];
for(const p of parts){if(p.startsWith('- ')){const last=blocks[blocks.length-1];if(last?.kind==='ul')last.items!.push(p.slice(2));else blocks.push({kind:'ul',text:'',items:[p.slice(2)]})}else if(/^##?\s/.test(p)||/^\d+\.\s\w/.test(p)&&p.length<100)blocks.push({kind:'h2',text:p.replace(/^##?\s/,'')});else blocks.push({kind:'p',text:p})}
---
{blocks.map(b=>b.kind==='h2'?<h2>{b.text}</h2>:b.kind==='ul'?<ul>{b.items!.map(t=><li>{t}</li>)}</ul>:<p>{b.text}</p>)}

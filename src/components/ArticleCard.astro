---
import {articleImages} from '@content/article-images';import Icon from './Icon.astro';import type {CollectionEntry} from 'astro:content';interface Props{post:CollectionEntry<'blog'>;index?:number;compact?:boolean};const {post,index=0,compact=false}=Astro.props;const p=post.data;const img=articleImages[post.id]||{src:'/images/pipework.webp',alt:'Plumbing pipework and valves.'};const date=new Date(p.date+'T12:00:00Z').toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});
---
<article class:list={['article-card',{compact}]} data-article data-search={(p.title+' '+p.category).toLowerCase()} data-category={p.category}><a href={p.path}>{!compact&&<div class={'article-photo photo-'+index}><img src={img.src} alt={img.alt} width="780" height="390" loading="lazy"/></div>}<div class="article-body"><span class="article-meta mono">{p.category}</span><h3>{p.title}</h3><div class="article-bottom"><time datetime={p.date}>{date}</time><Icon name="arrow" size={17}/></div></div></a></article>

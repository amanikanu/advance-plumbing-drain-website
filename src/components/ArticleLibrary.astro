---
import {getCollection} from 'astro:content';import ArticleCard from './ArticleCard.astro';import Icon from './Icon.astro';const {tag=''}=Astro.props;const posts=(await getCollection('blog')).filter(p=>!tag||p.data.tags.includes(tag)).sort((a,b)=>b.data.date.localeCompare(a.data.date));const cats=Array.from(new Set(posts.map(p=>p.data.category)));
---
<div class="container article-library"><div class="catalog-tools"><label class="blog-search"><span class="sr-only">Search journal articles</span><Icon name="search" size={17}/><input type="search" placeholder="Search the journal…" aria-controls="article-results"/></label><div class="filter-tabs" aria-label="Filter by topic">{['All topics',...cats].map((c,i)=><button type="button" aria-pressed={i===0?'true':'false'} data-filter={i===0?'':c}>{c}</button>)}</div></div><p class="listing-count" role="status">{posts.length} articles</p><div class="articles-grid" id="article-results">{posts.map(post=><ArticleCard post={post} compact/>)}</div><div class="empty-results" hidden><h2>No matching articles.</h2><p>Try a different search term or clear the topic filter.</p><button class="text-link clear-search" type="button">Clear search and filters <Icon name="arrow" size={14}/></button></div><button class="button button-outline load-more" type="button" hidden>Show more articles <Icon name="plus" size={15}/></button></div>
<script>
 document.querySelectorAll<HTMLElement>('.article-library').forEach(lib=>{const cards=Array.from(lib.querySelectorAll<HTMLElement>('[data-article]')),search=lib.querySelector<HTMLInputElement>('input[type="search"]')!,buttons=Array.from(lib.querySelectorAll<HTMLButtonElement>('[data-filter]')),more=lib.querySelector<HTMLButtonElement>('.load-more')!;let topic='',limit=9;function update(){const q=search.value.trim().toLowerCase(),matches=cards.filter(c=>(!topic||c.dataset.category===topic)&&(!q||c.dataset.search?.includes(q)));cards.forEach(c=>{c.hidden=!matches.slice(0,limit).includes(c)});lib.querySelector('.listing-count')!.textContent='Showing '+Math.min(matches.length,limit)+' of '+matches.length+' articles';(lib.querySelector('.empty-results') as HTMLElement).hidden=matches.length>0;more.hidden=matches.length<=limit;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===topic)))}search.addEventListener('input',()=>{limit=9;update()});buttons.forEach(b=>b.addEventListener('click',()=>{topic=b.dataset.filter||'';limit=9;update()}));more.addEventListener('click',()=>{const shown=cards.filter(c=>!c.hidden).length;limit+=9;update();cards.filter(c=>!c.hidden)[shown]?.querySelector('a')?.focus({preventScroll:true})});lib.querySelector('.clear-search')?.addEventListener('click',()=>{topic='';search.value='';limit=9;update();search.focus()});update()});
</script>

---
const subject = 'Inquiry about getting this website';
const body = `Hi Must team,

I saw this website preview and I would like to get this site for my business.

Please let me know how to proceed!

Thanks`;
const mailto = `mailto:sales@must.company?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<aside class="static-preview-banner" aria-label="Website preview notice">
  <div class="static-preview-inner">
    <div class="static-preview-copy">
      <p class="static-preview-title">A WEBSITE MADE FOR YOUR BUSINESS</p>
      <p class="static-preview-expiry"><span aria-hidden="true">🕒</span> This preview will be deleted in 30 days</p>
    </div>
    <a class="static-preview-cta" href={mailto}>Get this site <span aria-hidden="true">↗</span></a>
  </div>
</aside>

<style>
  .static-preview-banner {
    position: static;
    width: 100%;
    padding: 12px 16px;
    border-top: 1px solid rgb(255 255 255 / 10%);
    background: #0b1117;
    color: #fff;
  }

  .static-preview-inner {
    width: min(100%, 1280px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .static-preview-copy {
    min-width: 0;
  }

  .static-preview-title,
  .static-preview-expiry {
    margin: 0;
  }

  .static-preview-title {
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .18em;
    line-height: 1.4;
  }

  .static-preview-expiry {
    margin-top: 3px;
    color: #c3cbd2;
    font-size: 12px;
    line-height: 1.45;
  }

  .static-preview-expiry span {
    color: #59d4d2;
    margin-right: 4px;
  }

  .static-preview-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    gap: 8px;
    min-height: 42px;
    padding: 10px 18px;
    border-radius: 999px;
    background: #fff;
    color: #0b1117;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 4px 12px rgb(0 0 0 / 18%);
    transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
  }

  .static-preview-cta:hover {
    background: #dffcf9;
    box-shadow: 0 6px 16px rgb(0 0 0 / 24%);
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .static-preview-inner {
      align-items: stretch;
      flex-direction: column;
      gap: 12px;
    }

    .static-preview-cta {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .static-preview-cta {
      transition: none;
    }
  }
</style>

---
import Icon from './Icon.astro';interface Props{items:{name:string;href:string}[]};const {items}=Astro.props;
---
<nav aria-label="Breadcrumb" class="breadcrumbs"><a href="/">Home</a>{items.map((item,i)=><><Icon name="chevronRight" size={11}/>{i===items.length-1?<span aria-current="page">{item.name}</span>:<a href={item.href}>{item.name}</a>}</>)}</nav>

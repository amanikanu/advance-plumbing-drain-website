---
import Icon from './Icon.astro';import {business,address} from '@content/business';
---
<div class="map-facade" data-map-address={address}><div class="map-drawing" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 260" preserveAspectRatio="xMidYMid slice"><defs><pattern id="streets" x="0" y="0" width="58" height="37" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)"><rect x="3" y="3" width="51" height="30" rx="2" fill="#dce2db"/><rect x="8" y="7" width="11" height="21" fill="#cfd8d0"/><rect x="25" y="7" width="23" height="21" fill="#d2dcd4"/></pattern></defs><rect width="600" height="260" fill="#f4f5ec"/><rect width="600" height="260" fill="url(#streets)"/><path d="M-20 215C130 153 211 192 333 89S556 61 630-20" fill="none" stroke="#e1d3b6" stroke-width="15"/><path d="M-20 215C130 153 211 192 333 89S556 61 630-20" fill="none" stroke="#fdfcf5" stroke-width="11"/><path d="m-20 5 164-24 32 87-90 47zM497 178l76-26 27 84-80 23z" fill="#b6ceb8"/><path d="m300-20 50 300" stroke="#fafbf4" stroke-width="10"/></svg></div><div class="map-marker"><Icon name="pin" size={26}/></div><button type="button" class="button map-load"><Icon name="map" size={16}/>Load interactive map</button><a class="map-external" href={business.profiles.google} target="_blank" rel="noopener noreferrer">Open in Google Maps <Icon name="upRight" size={12}/></a></div>
<script>
 document.querySelectorAll<HTMLElement>('.map-facade').forEach(el=>el.querySelector('button')?.addEventListener('click',()=>{const map=document.createElement('iframe');map.title='Map of the Advanced Plumbing & Drain office';map.referrerPolicy='no-referrer';map.loading='lazy';map.src='https://maps.google.com/maps?q='+encodeURIComponent(el.dataset.mapAddress||'')+'&z=15&output=embed';map.setAttribute('allowfullscreen','');el.prepend(map);el.classList.add('map-loaded');el.querySelector('button')!.hidden=true;map.focus()}));
</script>

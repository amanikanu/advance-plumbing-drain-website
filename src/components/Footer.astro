---
import {business,phoneLink} from '@content/business';import {footerNav} from '@content/navigation';import Icon from './Icon.astro';
---
<footer class="site-footer"><div class="container"><div class="footer-grid"><div class="footer-brand"><a href="/"><span class="footer-wordmark">ADVANCED<span>PLUMBING & DRAIN</span></span></a><p>Residential & commercial plumbing.<br/>San Francisco & San Mateo County.</p><a class="footer-phone" href={phoneLink}><Icon name="phone" size={15}/>{business.phone}</a><small class="mono">CA LICENSE #{business.license}</small></div>{Object.entries(footerNav).map(([title,items])=><div class="footer-col"><h2>{title}</h2>{items.map(l=><a href={l.href}>{l.name}</a>)}</div>)}</div>
<div class="footer-bottom"><span>© {new Date().getFullYear()} {business.name}</span><nav aria-label="Legal and privacy"><a href="/privacy-policy/">Privacy</a><a href="/terms-of-service/">Terms</a><a href="/accessibility/">Accessibility</a><a href="/sitemap/">Sitemap</a><button type="button" class="privacy-open">Privacy choices</button></nav></div></div></footer>
<dialog class="privacy-dialog" aria-labelledby="privacy-title"><button class="dialog-close" type="button" aria-label="Close privacy choices"><Icon name="close" size={20}/></button><span class="section-label">YOUR PREFERENCES</span><h2 id="privacy-title">Privacy choices</h2><p>Essential features keep the site and request form working. Optional analytics are off unless you choose to enable them.</p><div class="choice-row"><strong>Essential features</strong><span>Always on</span></div><label class="choice-row"><strong>Usage analytics</strong><input type="checkbox" name="allow-analytics"/></label><p class="choice-note">No names, phone numbers, addresses, or form descriptions are included in analytics events.</p><div class="dialog-actions"><button type="button" class="button button-outline privacy-decline">Essential only</button><button type="button" class="button button-teal privacy-save">Save choices</button></div></dialog>

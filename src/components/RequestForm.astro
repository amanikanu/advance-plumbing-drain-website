---
import Icon from './Icon.astro';import SectionLabel from './SectionLabel.astro';import {business,phoneLink} from '@content/business';import {serviceTypes,urgencies} from '@content/form-options.mjs';
const {service='',emergency=false}=Astro.props;
const preview=import.meta.env.PUBLIC_REQUEST_MODE!=='live';
---
<section class="request-section" id="request-service" aria-labelledby="request-heading"><div class="container request-grid"><div class="request-intro"><SectionLabel text="SERVICE REQUEST"/><h2 id="request-heading">Let’s get it fixed.</h2><p>Tell us what’s happening. We’ll use your details to discuss the problem and the next steps.</p><div class="request-aside-call"><span class="mono">PREFER TO TALK?</span><a href={phoneLink}><Icon name="phone" size={20}/>{business.phone}</a><small><i class="status-dot dark-dot"></i> Available 24 hours, every day</small></div>
{business.schedulerUrl&&<a class="text-link" data-event="scheduler_click" href={business.schedulerUrl}>Book Online <Icon name="upRight" size={16}/></a>}
</div><div class="form-panel"><form class="request-form" method="post" action="/api/request" novalidate data-preview={String(preview)}>
 <div class="form-progress" aria-label="Request progress"><span class="progress-step active" data-progress="1"><b>01</b> Service details</span><span class="progress-rule"></span><span class="progress-step" data-progress="2"><b>02</b> Contact details</span></div>
 <div class="form-step" data-step="1"><h3>What can we help with?</h3><div class="form-row"><div class="field"><label for="service">Service type</label><div class="select-wrap"><select id="service" name="service" required aria-describedby="error-service"><option value="">Select a service</option>{serviceTypes.map(s=><option value={s} selected={service===s}>{s}</option>)}</select><Icon name="chevron" size={15}/></div><small class="field-error" id="error-service"></small></div>
 <div class="field"><label for="urgency">How urgent is it?</label><div class="select-wrap"><select id="urgency" name="urgency" required aria-describedby="error-urgency"><option value="">Select urgency</option>{urgencies.map(s=><option value={s} selected={emergency&&s==='Emergency now'}>{s}</option>)}</select><Icon name="chevron" size={15}/></div><small class="field-error" id="error-urgency"></small></div></div>
 <div class="urgency-help" hidden={!emergency}><Icon name="siren" size={23}/><div><strong>For urgent help, call now.</strong><a class="button button-emergency" href={phoneLink} data-event="emergency_call"><Icon name="phone" size={15}/>{business.phone}</a></div></div>
 <div class="field"><label for="description">Briefly describe the problem</label><textarea name="description" id="description" rows="3" minlength="5" maxlength="1500" required placeholder="For example, the kitchen sink is draining slowly…" aria-describedby="error-description"></textarea><small class="field-error" id="error-description"></small></div>
 <div class="form-controls"><span class="step-count mono">STEP 1 OF 2</span><button type="button" class="button button-teal next-step">Continue <Icon name="arrow" size={16}/></button></div></div>
 <div class="form-step" data-step="2" hidden><h3>How can we reach you?</h3><div class="form-row"><div class="field"><label for="name">Full name</label><input name="name" id="name" required autocomplete="name" minlength="2" maxlength="100" placeholder="Your full name" aria-describedby="error-name"/><small class="field-error" id="error-name"></small></div><div class="field"><label for="phone">Phone number</label><input name="phone" id="phone" type="tel" autocomplete="tel" required maxlength="26" placeholder="(415) 555-0100" aria-describedby="error-phone"/><small class="field-error" id="error-phone"></small></div></div>
 <div class="form-row"><div class="field"><label for="zip">ZIP code</label><input id="zip" name="zip" inputmode="numeric" autocomplete="postal-code" required maxlength="5" pattern="[0-9]{5}" placeholder="94118" aria-describedby="error-zip"/><small class="field-error" id="error-zip"></small></div><div class="field"><label for="email">Email <span>Optional</span></label><input type="email" name="email" id="email" autocomplete="email" maxlength="254" placeholder="you@example.com" aria-describedby="error-email"/><small class="field-error" id="error-email"></small></div></div>
 <details class="optional-address"><summary>Add service address <span>(optional)</span></summary><div class="field"><label for="address">Street address</label><input id="address" name="address" autocomplete="street-address" maxlength="180"/></div></details>
 <div class="check-field"><label><input id="privacy-ack" name="privacy" type="checkbox" required aria-describedby="error-privacy"/> <span>I have read the <a href="/privacy-policy/" target="_blank" rel="noopener">privacy policy</a>.</span></label><small class="field-error" id="error-privacy"></small></div>
 {business.showSmsOptIn&&business.smsConsentText&&<label class="check-field"><input name="sms" type="checkbox"/>{business.smsConsentText}</label>}
 <div class="honey" aria-hidden="true" inert><label for="website">Leave this field empty</label><input name="website" id="website" tabindex="-1" autocomplete="off"/></div>
 {preview&&<p class="preview-note"><Icon name="file" size={14}/>Preview mode: no request or email will be sent.</p>}
 <div class="form-controls"><button class="back-step" type="button"><Icon name="back" size={15}/>Back</button><button class="button button-teal submit-request" type="submit">{preview?'Complete preview':'Send request'}<Icon name="arrow" size={16}/></button></div></div>
 <div class="form-feedback" role="alert"></div><noscript><p>JavaScript is needed for this form. <a href={phoneLink}>Call {business.phone}</a> or <a href={'mailto:'+business.email}>email the office</a> to request service.</p></noscript>
 </form><div class="form-success" role="status" tabindex="-1" hidden><span class="success-icon"><Icon name="check" size={30}/></span><span class="mono">SERVICE REQUEST</span><h3></h3><p></p><div class="reference mono"></div><a class="button button-teal" href={phoneLink}><Icon name="phone" size={17}/>Call the office</a><button type="button" class="reset-form text-link">Start another request <Icon name="arrow" size={15}/></button></div>
</div></div></section>
<script src="../scripts/form.ts"></script>
